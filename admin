function makeFolderCard(name,count){
  const el=document.createElement("article");
  el.className="card folder-card";
  el.tabIndex=0;
  el.innerHTML=`
    <div class="thumb">
      <div class="folder-icon">${folderSVG()}</div>
      ${viewMode==="grid"?`<span class="folder-count">${count}</span>`:""}
    </div>
    <div class="name">${esc(name)}</div>
    ${viewMode==="list"?`<span class="folder-count">${count} file${count!==1?"s":""}</span>`:""}
  `;
  el.onclick=()=>{currentFolder=name;renderProducts()};
  return el;
}
function makeSectionLabel(text){
  const el=document.createElement("div");
  el.className="section-label";
  el.textContent=text;
  return el;
}

function renderBreadcrumb(){
  const bc=$("#breadcrumb");
  const labels={all:"📚 All files",folders:"📁 Folders",date:"📅 By date",alpha:"🔤 A–Z",category:"🏷️ Category"};
  if(displayMode!=="folders"||currentFolder===null){
    bc.innerHTML=`<span class="crumb current">${labels[displayMode]}</span>`;
    return;
  }
  bc.innerHTML=`<span class="crumb" data-root="1">📁 All folders</span>
    <span class="sep">›</span>
    <span class="crumb current">${esc(currentFolder)}</span>`;
  bc.querySelector("[data-root]").onclick=()=>{currentFolder=null;renderProducts()};
}

function renderProducts(){
  renderBreadcrumb();
  updateModeTabs();
  const box=$("#products");
  const q=$("#search").value.trim().toLowerCase();
  box.innerHTML="";

  const F=Object.entries(filesCache);
  const filtered=F.filter(([,f])=>[f.title,f.description,f.category,f.folder].join(" ").toLowerCase().includes(q));

  if(displayMode==="folders"){
    if(currentFolder===null){
      const groups={};
      Object.values(filesCache).forEach(f=>{(groups[f.folder]=groups[f.folder]||[]).push(f)});
      const names=Object.keys(groups).sort();
      const visible=names.filter(name=>{
        if(!q)return true;
        if(name.toLowerCase().includes(q))return true;
        return groups[name].some(f=>[f.title,f.description,f.category].join(" ").toLowerCase().includes(q));
      });
      if(!visible.length){
        box.innerHTML=`<div class="empty"><span class="ico">📂</span>${q?"No folders match search.":"No folders yet."}</div>`;
        return;
      }
      visible.forEach(name=>box.append(makeFolderCard(name,groups[name].length)));
      return;
    }
    const files=filtered.filter(([,f])=>f.folder===currentFolder)
      .sort((a,b)=>(b[1].createdAt||0)-(a[1].createdAt||0));
    if(!files.length){
      box.innerHTML=`<div class="empty"><span class="ico">📁</span>${q?"No files match.":"This folder is empty."}</div>`;
      return;
    }
    files.forEach(([id,f])=>box.append(makeFileCard(id,f)));
    return;
  }

  if(!filtered.length){
    box.innerHTML=`<div class="empty"><span class="ico">📚</span>${q?"No files match search.":"No materials yet. Upload your first file from the dock below."}</div>`;
    return;
  }

  if(displayMode==="all"){
    filtered.sort((a,b)=>(b[1].createdAt||0)-(a[1].createdAt||0))
      .forEach(([id,f])=>box.append(makeFileCard(id,f)));
    return;
  }

  if(displayMode==="date"){
    filtered.sort((a,b)=>(b[1].createdAt||0)-(a[1].createdAt||0));
    const groups={};
    filtered.forEach(([id,f])=>{const k=dateOnly(f.createdAt);(groups[k]=groups[k]||[]).push([id,f])});
    Object.keys(groups).forEach(k=>{
      box.append(makeSectionLabel(`${k} · ${groups[k].length} file${groups[k].length!==1?"s":""}`));
      groups[k].forEach(([id,f])=>box.append(makeFileCard(id,f)));
    });
    return;
  }

  if(displayMode==="alpha"){
    filtered.sort((a,b)=>a[1].title.localeCompare(b[1].title,undefined,{sensitivity:"base"}));
    const groups={};
    filtered.forEach(([id,f])=>{
      const first=(f.title||"#").trim().charAt(0).toUpperCase();
      const key=/[A-Z]/.test(first)?first:"#";
      (groups[key]=groups[key]||[]).push([id,f]);
    });
    const keys=Object.keys(groups).sort((a,b)=>{if(a==="#")return 1;if(b==="#")return -1;return a.localeCompare(b)});
    keys.forEach(k=>{
      box.append(makeSectionLabel(`${k} · ${groups[k].length} file${groups[k].length!==1?"s":""}`));
      groups[k].forEach(([id,f])=>box.append(makeFileCard(id,f)));
    });
    return;
  }

  if(displayMode==="category"){
    filtered.sort((a,b)=>(b[1].createdAt||0)-(a[1].createdAt||0));
    const groups={};
    filtered.forEach(([id,f])=>{const k=f.category||"Other";(groups[k]=groups[k]||[]).push([id,f])});
    Object.keys(groups).sort().forEach(k=>{
      box.append(makeSectionLabel(`${k} · ${groups[k].length} file${groups[k].length!==1?"s":""}`));
      groups[k].forEach(([id,f])=>box.append(makeFileCard(id,f)));
    });
    return;
  }
}
