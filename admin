/* ============ helpers ============ */
function esc(s){return String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}
function date(ts){return ts?new Date(ts).toLocaleString([], {month:"short",day:"numeric",hour:"2-digit",minute:"2-digit"}):""}
function dateOnly(ts){
  if(!ts)return"Unknown";
  const d=new Date(ts); const today=new Date(); const yest=new Date(); yest.setDate(today.getDate()-1);
  const same=(a,b)=>a.toDateString()===b.toDateString();
  if(same(d,today))return"Today"; if(same(d,yest))return"Yesterday";
  return d.toLocaleDateString([], {year:"numeric",month:"long",day:"numeric"});
}
function push(path,data){return db.ref(path).push(data)}
function listen(path,fn){const ref=db.ref(path),cb=s=>fn(s.val()||{});ref.on("value",cb);unsubs.push(()=>ref.off("value",cb))}
function stopAll(){unsubs.forEach(f=>f());unsubs=[]}
function authMessage(t,ok=false){$("#authMsg").textContent=t;$("#authMsg").className="auth-msg "+(ok?"ok":"err")}
function extOf(name){return (String(name||"").split(".").pop()||"").toLowerCase()}
function fmtBytes(b){if(!b)return"";return b>1048576?(b/1048576).toFixed(1)+" MB":Math.ceil(b/1024)+" KB"}
function roleOf(uid){return db.ref("users/"+uid+"/role").once("value").then(s=>s.val())}

function normFile(f){
  return {
    ...f,
    title: f.title||f.name||"Untitled",
    category: f.category||f.cat||"Learning material",
    description: f.description||f.desc||"",
    folder: (f.folder||"General").trim()||"General",
    createdAt: f.createdAt||f.ts||Date.now(),
    simulation: !!f.simulation,
    format: f.format||extOf(f.url||"")
  };
}
function isPdf(f){const u=(f.url||"").toLowerCase().split("?")[0];return u.endsWith(".pdf")||f.category==="PDF"}
function isImage(f){return (f.format||extOf(f.url||"")).match(/^(jpe?g|png|gif|webp|svg|bmp|avif)$/i)}
function isVideo(f){return (f.format||extOf(f.url||"")).match(/^(mp4|webm|mov|m4v|ogg|avi)$/i)}
function fileKind(f){
  if(isPdf(f))return"pdf";if(isImage(f))return"image";if(isVideo(f))return"video";
  const fmt=(f.format||"").toLowerCase();
  if(["xlsx","xls","csv"].includes(fmt))return"excel";
  if(["html","htm"].includes(fmt))return"html";
  if(["doc","docx","txt","rtf","odt"].includes(fmt))return"doc";
  return"other";
}
function folderSVG(){
  return `<svg viewBox="0 0 64 54" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
    <path d="M6 12a4 4 0 0 1 4-4h14l5 5h25a4 4 0 0 1 4 4v2H6v-7z" fill="#c9862a"/>
    <path d="M6 15h52a4 4 0 0 1 4 4v23a4 4 0 0 1-4 4H10a4 4 0 0 1-4-4V15z" fill="#e9a23b"/>
    <path d="M6 15h52a4 4 0 0 1 4 4v3H6v-7z" fill="#f4b862"/>
  </svg>`;
}
function badgeFor(f){
  const k=fileKind(f);
  return {pdf:"PDF",image:"IMG",video:"VID",excel:"XLS",html:"HTML",doc:"DOC",other:"FILE"}[k]||"FILE";
}

