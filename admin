/* ============ UPLOAD ============ */
const widgetCache={};
function showUpMsg(txt,ok=false){
  const el=$("#upMsg");
  el.textContent=txt;
  el.className="up-msg "+(ok?"ok":"err");
}
function clearUpMsg(){$("#upMsg").textContent="";$("#upMsg").className="up-msg"}

function buildWidget(kind){
  if(widgetCache[kind])return widgetCache[kind];
  if(!window.cloudinary){showUpMsg("Cloudinary widget not loaded.",false);return null}
  const resourceType=(kind==="image"||kind==="video")?kind:"auto";
  const cfg={
    cloudName:CLOUDINARY_CLOUD,
    uploadPreset:CLOUDINARY_PRESET,
    folder:"rds_library",
    resourceType:resourceType,
    multiple:true,
    maxFileSize:100000000
  };
  if(kind==="pdf")cfg.clientAllowedFormats=["pdf","doc","docx","txt","rtf","odt"];
  if(kind==="image")cfg.clientAllowedFormats=["jpg","jpeg","png","gif","webp","svg","bmp","avif"];
  if(kind==="video")cfg.clientAllowedFormats=["mp4","webm","mov","m4v","ogg","avi"];
  if(kind==="excel")cfg.clientAllowedFormats=["xlsx","xls","csv"];
  if(kind==="html")cfg.clientAllowedFormats=["html","htm","zip"];

  const w=cloudinary.createUploadWidget(cfg,(err,res)=>{
    if(err){showUpMsg("Upload error: "+(err.message||JSON.stringify(err)),false);return}
    if(!res)return;
    if(res.event==="uploadprogress"){
      const pct=Math.round(res.info?.progress||0);
      $("#upProgress").classList.remove("hidden");
      $("#upProgress").firstElementChild.style.width=pct+"%";
      showUpMsg(`Uploading… ${pct}%`);
    }
    if(res.event==="success"){
      saveUploaded(res.info);
    }
    if(res.event==="error"){
      showUpMsg("Upload failed: "+(res.info?.error?.message||"unknown"),false);
    }
    if(res.event==="close"){
      setTimeout(()=>$("#upProgress").classList.add("hidden"),400);
    }
  });
  widgetCache[kind]=w;
  return w;
}
document.querySelectorAll(".upload-grid button[data-kind]").forEach(b=>{
  b.onclick=()=>{
    if(!admin)return;
    const w=buildWidget(b.dataset.kind);
    if(w)w.open();
  };
});

async function saveUploaded(info){
  const url=info.secure_url;
  const ext=(info.format||extOf(url)||"").toLowerCase();
  let name=info.original_filename||("file."+ext);
  if(ext && !name.toLowerCase().endsWith("."+ext))name+="."+ext;

  const titleInput=$("#upTitle").value.trim();
  const record={
    title: titleInput || name,
    name,
    url,
    folder: $("#upFolder").value.trim() || "General",
    category: $("#upCategory").value || autoCategory(ext,info.resource_type),
    description: $("#upDesc").value.trim(),
    simulation: $("#upSim").checked,
    by: admin.uid,
    createdAt: Date.now(),
    size: info.bytes,
    format: ext
  };
  try{
    await push("files",record);
    showUpMsg("✅ Uploaded: "+name,true);
    $("#upTitle").value="";
    $("#upDesc").value="";
    $("#upSim").checked=false;
    setTimeout(clearUpMsg,3500);
  }catch(e){
    showUpMsg("Saved to Cloudinary but DB failed: "+e.message,false);
  }
}
function autoCategory(ext,rt){
  if(rt==="image")return"Image";if(rt==="video")return"Video";
  if(ext==="pdf")return"PDF";
  if(["xlsx","xls","csv"].includes(ext))return"Excel";
  if(["html","htm"].includes(ext))return"HTML";
  if(["doc","docx","txt","rtf","odt"].includes(ext))return"Document";
  return"Other";
}

/* add link */
$("#addLinkBtn").onclick=async()=>{
  const url=$("#upUrl").value.trim();
  if(!url)return showUpMsg("Enter a URL.",false);
  try{new URL(url)}catch(e){return showUpMsg("Enter a valid URL.",false)}
  const title=$("#upTitle").value.trim() || url.split("/").pop() || "Link";
  try{
    await push("files",{
      title,url,
      folder: $("#upFolder").value.trim()||"General",
      category: $("#upCategory").value||"Link",
      description: $("#upDesc").value.trim(),
      simulation: $("#upSim").checked,
      by: admin.uid,createdAt:Date.now()
    });
    $("#upUrl").value="";$("#upTitle").value="";$("#upDesc").value="";
    showUpMsg("✅ Link added.",true);
    setTimeout(clearUpMsg,2500);
  }catch(e){showUpMsg("Could not add link: "+e.message,false)}
};

/* ============ SETTINGS ============ */
$("#saveSettings").onclick=async()=>{
  try{
    await db.ref("settings").update({
      title:$("#setTitle").value.trim(),
      subtitle:$("#setSubtitle").value.trim(),
      footer:$("#setFooter").value.trim(),
      teacherName:$("#setTeacherName").value.trim(),
      teacherBio:$("#setTeacherBio").value.trim(),
      updatedAt:Date.now()
    });
    alert("Site details saved.");
    closeModal("settingsModal");
  }catch(e){alert("Save failed: "+e.message)}
};

/* ============ NOTICES ============ */
$("#postNotice").onclick=async()=>{
  const title=$("#noticeTitle").value.trim(),body=$("#noticeBody").value.trim();
  if(!title||!body)return alert("Enter a title and message.");
  try{
    await push("notices",{
      title,body,by:admin.uid,
      byName:$("#setTeacherName").value.trim()||admin.email,
      createdAt:Date.now()
    });
    $("#noticeTitle").value="";$("#noticeBody").value="";
  }catch(e){alert("Could not publish: "+e.message)}
};
function renderNotices(data){
  const box=$("#noticesList");
  if(!box)return;
  box.innerHTML="";
  Object.entries(data).sort((a,b)=>(b[1].createdAt||0)-(a[1].createdAt||0)).forEach(([id,n])=>{
    const el=document.createElement("div");
    el.className="list-item";
    el.innerHTML=`
      <div class="li-body">
        <b>${esc(n.title)}</b>
        <div>${esc(n.body)}</div>
        <div class="meta">${esc(date(n.createdAt))}</div>
      </div>
      <button class="btn sm danger">Delete</button>
    `;
    el.querySelector("button").onclick=async()=>{
      if(!confirm("Delete this notice?"))return;
      try{await db.ref("notices/"+id).remove();}catch(e){alert(e.message)}
    };
    box.append(el);
  });
  if(!box.children.length)box.innerHTML='<p class="muted">No notices yet.</p>';
}

/* ============ COMMENTS ============ */
function renderComments(data){
  const box=$("#commentsList");
  if(!box)return;
  box.innerHTML="";
  let count=0;
  Object.entries(data).forEach(([fileId,rows])=>{
    Object.entries(rows||{}).forEach(([id,c])=>{
      count++;
      const el=document.createElement("div");
      el.className="list-item";
      el.innerHTML=`
        <div class="li-body">
          <b>${esc(c.name||"Student")}</b>
          <span class="meta">on ${esc(c.fileTitle||"material")} · ${esc(date(c.createdAt))}</span>
          <div>${esc(c.text)}</div>
        </div>
        <button class="btn sm danger">Remove</button>
      `;
      el.querySelector("button").onclick=async()=>{
        try{await db.ref("comments/"+fileId+"/"+id).remove();}catch(e){alert(e.message)}
      };
      box.append(el);
    });
  });
  if(!count)box.innerHTML='<p class="muted">No comments yet.</p>';
}

/* ============ CHATS ============ */
let chatUnsub=null;
function renderStudentList(data){
  const box=$("#studentList");
  if(!box)return;
  box.innerHTML="";
  const entries=Object.entries(data);
  if(!entries.length){
    box.innerHTML='<p class="muted">No student conversations yet.</p>';
    return;
  }
  entries.forEach(([uid,conv])=>{
    const u=conv.user||{};
    const row=document.createElement("div");
    row.className="student-row";
    const initial=(u.name||u.email||uid).trim().charAt(0).toUpperCase();
    row.innerHTML=`
      <div class="st-av">${esc(initial)}</div>
      <div class="st-info">
        <b>${esc(u.name||u.email||uid)}</b>
        <span>${esc(u.lastMessage||u.email||"No messages yet")}</span>
      </div>
    `;
    row.onclick=()=>openConversation(uid,u);
    box.append(row);
  });
}
$("#backToStudents").onclick=()=>{
  $("#chatPanel").classList.add("hidden");
  $("#studentList").classList.remove("hidden");
  if(chatUnsub){chatUnsub();chatUnsub=null}
};
function openConversation(uid,u){
  openChat=uid;
  $("#studentList").classList.add("hidden");
  $("#chatPanel").classList.remove("hidden");
  $("#chatHeading").textContent=(u.name||u.email||uid);
  const ref=db.ref("conversations/"+uid+"/messages");
  if(chatUnsub)chatUnsub();
  const cb=s=>{
    const rows=s.val()||{};
    const box=$("#chatThread");
    box.innerHTML="";
    const arr=Object.values(rows).sort((a,b)=>(a.createdAt||0)-(b.createdAt||0));
    if(!arr.length)box.innerHTML='<p class="muted" style="text-align:center;padding:20px">No messages yet.</p>';
    arr.forEach(m=>{
      const mine=m.senderUid===admin.uid;
      const d=document.createElement("div");
      d.className="bubble "+(mine?"me":"them");
      d.innerHTML=esc(m.text)+`<span class="time">${date(m.createdAt)}</span>`;
      box.append(d);
    });
    box.scrollTop=box.scrollHeight;
  };
  ref.on("value",cb);
  chatUnsub=()=>ref.off("value",cb);
}
$("#sendReply").onclick=async()=>{
  const text=$("#replyText").value.trim();
  if(!text||!openChat)return;
  try{
    await push("conversations/"+openChat+"/messages",{
      text,
      senderUid:admin.uid,
      senderName:$("#setTeacherName").value.trim()||admin.email,
      createdAt:Date.now()
    });
    await db.ref("conversations/"+openChat+"/user").update({lastMessage:text,updatedAt:Date.now()});
    $("#replyText").value="";
  }catch(e){alert("Could not send: "+e.message)}
};

/* ============ MODALS ============ */
function openModal(id){
  closeAllModals();
  $("#"+id).classList.add("open");
}
function closeModal(id){$("#"+id).classList.remove("open")}
function closeAllModals(){
  document.querySelectorAll(".modal-overlay").forEach(m=>m.classList.remove("open"));
  if(chatUnsub){chatUnsub();chatUnsub=null}
  $("#chatPanel").classList.add("hidden");
  $("#studentList").classList.remove("hidden");
}
document.querySelectorAll("[data-close]").forEach(b=>{
  b.onclick=()=>closeModal(b.dataset.close);
});
document.querySelectorAll(".modal-overlay").forEach(m=>{
  m.onclick=e=>{if(e.target===m)m.classList.remove("open")};
});
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeAllModals()});

$("#dockUpload").onclick=()=>openModal("uploadModal");
$("#dockSettings").onclick=()=>openModal("settingsModal");
$("#dockNotices").onclick=()=>openModal("noticesModal");
$("#dockComments").onclick=()=>openModal("commentsModal");
$("#dockChats").onclick=()=>openModal("chatsModal");

/* init */
setView(viewMode);
updateModeTabs();
</script>
