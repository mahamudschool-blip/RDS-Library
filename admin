<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>RDS Library — Admin</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@500;700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://upload-widget.cloudinary.com/global/all.js"></script>
<style>
:root{
  color-scheme:light dark;
  --bg:#f3f6fa;--card:#fff;--ink:#0d1b2a;--mute:#5a6879;--acc:#1f6f8b;--acc2:#0e5a75;
  --line:#e2e8f0;--bad:#b3261e;--soft:#eaf1f6;--shadow:0 2px 8px rgba(13,27,42,.06);
  --radius:12px;--folder:#e9a23b;--ok:#1f8a4c;
}
@media(prefers-color-scheme:dark){
  :root{--bg:#0b1420;--card:#131e2e;--ink:#e8eef7;--mute:#8b9bb0;--acc:#5cb8d6;--acc2:#7ecbe4;
    --line:#1f2c3e;--bad:#ff8a80;--soft:#182438;--shadow:0 2px 8px rgba(0,0,0,.35);
    --folder:#e9a23b;--ok:#4ade80}
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.5 Figtree,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
button,input,textarea,select{font:inherit;color:inherit}
button{cursor:pointer;border:0;background:none}
.hidden{display:none!important}
a{color:var(--acc);text-decoration:none;overflow-wrap:anywhere}
input,textarea,select{width:100%;padding:10px 12px;border:1.5px solid var(--line);border-radius:9px;
  background:var(--bg);color:var(--ink);outline:none;transition:border .15s,box-shadow .15s;margin:5px 0}
input:focus,textarea:focus,select:focus{border-color:var(--acc);box-shadow:0 0 0 3px var(--soft)}
textarea{min-height:70px;resize:vertical}
label.muted{display:block;font-size:12.5px;color:var(--mute);margin:8px 0 2px;font-weight:500}

/* buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;
  padding:10px 16px;border-radius:10px;font-weight:600;transition:background .15s,transform .1s}
.btn:active{transform:scale(.98)}
.btn.primary{background:var(--acc);color:#fff}
.btn.primary:hover{background:var(--acc2)}
.btn.secondary{background:transparent;border:1.5px solid var(--acc);color:var(--acc)}
.btn.secondary:hover{background:var(--soft)}
.btn.danger{background:transparent;border:1.5px solid var(--bad);color:var(--bad)}
.btn.danger:hover{background:rgba(179,38,30,.08)}
.btn.ghost{background:transparent;border:1.5px solid var(--line);color:var(--ink)}
.btn.ghost:hover{background:var(--soft)}
.btn.sm{padding:7px 11px;font-size:13px;border-radius:8px}

/* auth */
#auth{min-height:100vh;display:grid;place-items:center;padding:24px 16px;
  background:radial-gradient(circle at 20% 0%,var(--soft),var(--bg) 60%)}
.auth-card{width:100%;max-width:420px;background:var(--card);border:1px solid var(--line);
  border-radius:18px;padding:32px 28px;box-shadow:var(--shadow)}
.auth-logo{width:56px;height:56px;border-radius:14px;background:var(--acc);color:#fff;
  display:grid;place-items:center;font:700 22px 'Bricolage Grotesque',serif;margin-bottom:16px}
.auth-card h1{font:700 22px 'Bricolage Grotesque',Georgia,serif;margin:0 0 4px}
.auth-card p{color:var(--mute);margin:0 0 20px;font-size:14px}
.auth-actions{display:flex;gap:8px;margin-top:20px}
.auth-actions .btn{flex:1}
.auth-msg{margin-top:14px;font-size:13px;min-height:18px}
.auth-msg.err{color:var(--bad)}
.auth-msg.ok{color:var(--ok)}

/* app shell */
#app{display:flex;flex-direction:column;min-height:100vh}
.topbar{position:sticky;top:0;z-index:40;background:var(--card);
  border-bottom:1px solid var(--line);box-shadow:var(--shadow)}
.topbar-inner{max-width:1200px;margin:0 auto;padding:10px 16px;
  display:flex;align-items:center;gap:12px}
.brand{display:flex;align-items:center;gap:10px;min-width:0;flex-shrink:0}
.brand .logo{width:36px;height:36px;border-radius:10px;background:var(--acc);color:#fff;
  display:grid;place-items:center;font:700 15px 'Bricolage Grotesque',serif;flex:none}
.brand .title{font:700 16px 'Bricolage Grotesque',Georgia,serif;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:190px}
.admin-badge{font-size:10.5px;font-weight:700;letter-spacing:.05em;padding:3px 8px;border-radius:99px;
  background:var(--soft);color:var(--acc);text-transform:uppercase}
.spacer{flex:1}
.icon-btn{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;
  border:1.5px solid var(--line);background:var(--card);flex:none;position:relative;
  transition:background .15s,border-color .15s}
.icon-btn:hover{background:var(--soft);border-color:var(--acc)}
.avatar{width:38px;height:38px;border-radius:50%;background:var(--acc);color:#fff;
  display:grid;place-items:center;font-weight:700;font-size:14px;flex:none;
  border:2px solid var(--card);box-shadow:0 0 0 1.5px var(--line)}
.profile-wrap{position:relative;flex:none}
.profile-menu{position:absolute;right:0;top:calc(100% + 8px);min-width:220px;background:var(--card);
  border:1px solid var(--line);border-radius:12px;box-shadow:0 8px 24px rgba(0,0,0,.15);
  padding:6px;z-index:50}
.profile-menu .pm-head{padding:10px 12px;border-bottom:1px solid var(--line);margin-bottom:4px}
.profile-menu .pm-head b{display:block;font-size:14px}
.profile-menu .pm-head span{font-size:12px;color:var(--mute)}
.profile-menu button{display:flex;width:100%;align-items:center;gap:10px;padding:9px 12px;
  border-radius:8px;font-size:14px;text-align:left}
.profile-menu button:hover{background:var(--soft)}
.profile-menu button.danger{color:var(--bad)}

/* toolbar */
.toolbar{max-width:1200px;margin:0 auto;width:100%;padding:14px 16px 0;
  display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.mode-tabs{display:flex;gap:4px;background:var(--soft);padding:3px;border-radius:9px;flex-wrap:wrap}
.mode-tabs button{padding:6px 11px;border-radius:7px;font-size:13px;font-weight:600;color:var(--mute);
  display:inline-flex;align-items:center;gap:5px;white-space:nowrap}
.mode-tabs button.active{background:var(--card);color:var(--acc);box-shadow:var(--shadow)}
.view-toggle{display:flex;gap:4px;background:var(--soft);padding:3px;border-radius:9px}
.view-toggle button{padding:6px 10px;border-radius:7px;font-size:13px;font-weight:600;color:var(--mute)}
.view-toggle button.active{background:var(--card);color:var(--acc);box-shadow:var(--shadow)}
.search-box{position:relative;flex:1;min-width:140px}
.search-box input{margin:0;padding-left:32px}
.search-box::before{content:"🔍";position:absolute;left:10px;top:50%;transform:translateY(-50%);
  font-size:13px;opacity:.55;pointer-events:none}

.breadcrumb{display:flex;align-items:center;gap:6px;max-width:1200px;width:100%;
  margin:0 auto;padding:8px 16px 0;font-size:14px;color:var(--mute)}
.breadcrumb .crumb{color:var(--mute);font-weight:500;cursor:pointer;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis;max-width:240px}
.breadcrumb .crumb:hover{color:var(--acc)}
.breadcrumb .crumb.current{color:var(--ink);font-weight:600;cursor:default}
.breadcrumb .sep{opacity:.4}

/* content grid */
.products{max-width:1200px;margin:0 auto;width:100%;padding:8px 16px 40px;flex:1}
.grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}
@media(max-width:1000px){.grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:700px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:460px){.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}}

.section-label{grid-column:1/-1;font:700 13px 'Bricolage Grotesque',serif;
  color:var(--mute);text-transform:uppercase;letter-spacing:.06em;
  padding:8px 0 0;border-top:1px solid var(--line);margin-top:6px}
.section-label:first-child{border-top:0;margin-top:0;padding-top:0}

/* card */
.card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);
  overflow:hidden;cursor:pointer;transition:transform .12s,border-color .12s,box-shadow .12s;
  display:flex;flex-direction:column;position:relative}
.card:hover{transform:translateY(-2px);border-color:var(--acc);box-shadow:0 6px 18px rgba(31,111,139,.15)}
.card .thumb{aspect-ratio:4/3;background:var(--soft);display:grid;place-items:center;
  font:700 20px 'Bricolage Grotesque',sans-serif;color:var(--acc);overflow:hidden;position:relative}
.card .thumb img{width:100%;height:100%;object-fit:cover}
.card .thumb .type-tag{position:absolute;bottom:6px;right:6px;background:rgba(0,0,0,.65);color:#fff;
  font-size:9.5px;font-weight:700;letter-spacing:.04em;padding:2px 6px;border-radius:5px;text-transform:uppercase}
.card .name{padding:8px 10px 10px;font-size:13px;font-weight:600;line-height:1.3;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
  text-align:center;min-height:44px}
.card .quick-actions{position:absolute;top:6px;right:6px;display:flex;gap:4px;opacity:0;
  transition:opacity .15s;z-index:2}
.card:hover .quick-actions{opacity:1}
.card .quick-actions button{width:26px;height:26px;border-radius:50%;
  background:rgba(0,0,0,.65);color:#fff;font-size:13px;display:grid;place-items:center;
  backdrop-filter:blur(4px)}
.card .quick-actions button:hover{background:var(--acc)}
.card .quick-actions button.del:hover{background:var(--bad)}

/* folder card */
.card.folder-card .thumb{background:linear-gradient(180deg,var(--soft) 0%,rgba(233,162,59,.12) 100%);
  display:flex;flex-direction:column;justify-content:center;gap:4px}
.folder-icon{width:52px;height:44px;position:relative;flex:none;
  filter:drop-shadow(0 2px 3px rgba(0,0,0,.15))}
.folder-icon svg{display:block;width:100%;height:100%}
.folder-count{position:absolute;bottom:6px;left:6px;background:rgba(0,0,0,.6);color:#fff;
  font-size:10px;font-weight:700;padding:2px 7px;border-radius:99px}

/* list view */
.list .card{flex-direction:row;align-items:center;border-radius:10px;padding:8px 12px;gap:10px}
.list .card .thumb{width:48px;height:48px;aspect-ratio:1;flex:none;border-radius:8px;font-size:14px}
.list .card .name{flex:1;padding:0;text-align:left;min-height:0;
  -webkit-line-clamp:1;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.list .card .type-tag{position:static;background:var(--soft);color:var(--acc);font-size:10px;
  padding:2px 8px;border-radius:99px}
.list .card .quick-actions{position:static;opacity:1}
.list .card .quick-actions button{background:var(--soft);color:var(--ink)}
.list .card .quick-actions button:hover{background:var(--acc);color:#fff}
.list .folder-card .folder-icon{width:36px;height:30px;filter:none}
.list .folder-card{display:flex;align-items:center;gap:10px;padding:10px 12px}
.list .folder-card .thumb{width:36px;height:32px;aspect-ratio:unset;background:transparent;border:0}
.list .folder-card .name{flex:1;text-align:left;min-height:0;padding:0;font-size:14px}
.list .folder-card .folder-count{position:static;background:var(--soft);color:var(--folder);
  font-size:11px;padding:2px 8px;margin-left:auto}
.list .section-label{padding:14px 0 4px}

.empty{grid-column:1/-1;text-align:center;padding:60px 20px;color:var(--mute)}
.empty .ico{font-size:44px;display:block;margin-bottom:10px;opacity:.5}

/* bottom dock: upload / settings / notices / comments / chat */
.dock{max-width:1200px;margin:0 auto;width:100%;padding:0 16px 30px;
  display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px}
@media(max-width:760px){.dock{grid-template-columns:repeat(2,minmax(0,1fr))}}
.dock-btn{padding:14px 12px;border-radius:12px;background:var(--card);border:1.5px solid var(--line);
  display:flex;flex-direction:column;align-items:center;gap:4px;font-size:13px;font-weight:600;
  color:var(--ink);transition:border-color .15s,transform .1s,background .15s}
.dock-btn:hover{border-color:var(--acc);background:var(--soft)}
.dock-btn .ico{font-size:22px}

/* modal */
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:100;
  display:none;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(3px)}
.modal-overlay.open{display:flex}
.modal{background:var(--card);border-radius:16px;max-width:640px;width:100%;max-height:90vh;
  overflow:auto;box-shadow:0 24px 64px rgba(0,0,0,.35);position:relative}
.modal-head{display:flex;align-items:center;gap:10px;padding:18px 20px;
  border-bottom:1px solid var(--line);position:sticky;top:0;background:var(--card);z-index:1;
  border-radius:16px 16px 0 0}
.modal-head h3{font:700 17px 'Bricolage Grotesque',Georgia,serif;margin:0;flex:1}
.modal-head .close{width:34px;height:34px;border-radius:50%;background:var(--soft);
  display:grid;place-items:center;font-size:20px;color:var(--mute);flex:none}
.modal-head .close:hover{background:var(--line);color:var(--ink)}
.modal-body{padding:18px 20px 22px}
.modal-body .row{margin-top:10px;display:flex;gap:8px;flex-wrap:wrap}
.modal-body .row .btn{flex:1;min-width:120px}

/* upload area */
.upload-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;margin-top:10px}
.upload-grid button{padding:16px 10px;border-radius:10px;background:var(--bg);border:1.5px dashed var(--line);
  display:flex;flex-direction:column;align-items:center;gap:6px;font-size:13px;font-weight:600;
  color:var(--ink);transition:border-color .15s,color .15s}
.upload-grid button:hover{border-color:var(--acc);color:var(--acc)}
.upload-grid button .ico{font-size:20px}
.progress{height:6px;background:var(--line);border-radius:3px;overflow:hidden;margin-top:10px}
.progress i{display:block;height:100%;background:var(--acc);width:0;transition:width .2s}
.up-msg{font-size:13px;margin-top:10px;min-height:16px}
.up-msg.err{color:var(--bad)}
.up-msg.ok{color:var(--ok)}

/* inline edit row */
.edit-panel{grid-column:1/-1;background:var(--soft);border:1.5px solid var(--acc);
  border-radius:12px;padding:16px 18px;margin-top:6px}

/* list of notices / comments / chats */
.list-item{border-top:1px solid var(--line);padding:12px 0;display:flex;gap:10px;align-items:flex-start}
.list-item:first-child{border-top:0}
.list-item .li-body{flex:1;min-width:0;font-size:14px}
.list-item .li-body b{display:block;font-size:14px;margin-bottom:2px}
.list-item .li-body .meta{font-size:12px;color:var(--mute)}

/* chat panel inside modal */
.chat-thread{display:flex;flex-direction:column;gap:8px;max-height:260px;overflow:auto;padding:4px 0 10px}
.bubble{max-width:80%;padding:8px 12px;border-radius:12px;font-size:13.5px;line-height:1.4}
.bubble.me{align-self:flex-end;background:var(--acc);color:#fff;border-bottom-right-radius:4px}
.bubble.them{align-self:flex-start;background:var(--bg);border:1px solid var(--line);border-bottom-left-radius:4px}
.bubble .time{display:block;font-size:10.5px;opacity:.7;margin-top:2px}

/* chat sidebar (list of students) */
.student-row{display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:9px;
  border:1px solid var(--line);margin-bottom:6px;cursor:pointer;transition:background .12s,border-color .12s}
.student-row:hover{background:var(--soft);border-color:var(--acc)}
.student-row .st-av{width:34px;height:34px;border-radius:50%;background:var(--acc);color:#fff;
  display:grid;place-items:center;font-weight:700;font-size:13px;flex:none}
.student-row .st-info{flex:1;min-width:0}
.student-row .st-info b{display:block;font-size:14px}
.student-row .st-info span{font-size:12px;color:var(--mute);
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block}

footer.site-footer{border-top:1px solid var(--line);padding:16px;text-align:center;
  font-size:12.5px;color:var(--mute);background:var(--card)}
</style>
</head>
<body>

<!-- ============ AUTH ============ -->
<section id="auth">
  <div class="auth-card">
    <div class="auth-logo" id="loginLogo">R</div>
    <h1 id="loginTitle">RDS Library · Admin</h1>
    <p>Sign in with your admin account.</p>
    <label class="muted" for="email">Email</label>
    <input id="email" type="email" autocomplete="username" placeholder="you@example.com">
    <label class="muted" for="password">Password</label>
    <input id="password" type="password" autocomplete="current-password" placeholder="••••••••">
    <div class="auth-actions">
      <button id="login" class="btn primary">Sign in</button>
      <button id="signup" class="btn ghost">Create</button>
    </div>
    <p id="authMsg" class="auth-msg"></p>
  </div>
</section>

<!-- ============ APP ============ -->
<div id="app" class="hidden">
  <header class="topbar">
    <div class="topbar-inner">
      <div class="brand">
        <div class="logo" id="brandLogo">R</div>
        <div class="title" id="siteTitle">RDS Library</div>
        <span class="admin-badge">Admin</span>
      </div>
      <div class="spacer"></div>
      <div class="search-box" style="max-width:260px;flex:none">
        <input id="search" placeholder="Search files…">
      </div>
      <div class="profile-wrap">
        <button class="avatar" id="btnProfile" aria-label="Account">
          <span id="avatarInitial">?</span>
        </button>
        <div id="profileMenu" class="profile-menu hidden">
          <div class="pm-head">
            <b id="pmName">Admin</b>
            <span id="pmEmail"></span>
          </div>
          <button id="menuSettings">⚙️ Site settings</button>
          <button id="menuNotices">📢 Notices</button>
          <button id="menuComments">💬 Comments</button>
          <button id="menuChats">✉️ Student chats</button>
          <button id="menuSignout" class="danger">🚪 Sign out</button>
        </div>
      </div>
    </div>
  </header>

  <div class="toolbar">
    <div class="mode-tabs" id="modeTabs">
      <button data-mode="all" class="active">📚 All</button>
      <button data-mode="folders">📁 Folders</button>
      <button data-mode="date">📅 By date</button>
      <button data-mode="alpha">🔤 A–Z</button>
      <button data-mode="category">🏷️ Category</button>
    </div>
    <div class="spacer"></div>
    <div class="view-toggle">
      <button id="viewGrid" class="active" data-view="grid">▦ Grid</button>
      <button id="viewList" data-view="list">☰ List</button>
    </div>
  </div>

  <div class="breadcrumb" id="breadcrumb"></div>

  <main class="products">
    <div id="products" class="grid"></div>
  </main>

  <!-- Bottom dock -->
  <div class="dock">
    <button class="dock-btn" id="dockUpload"><span class="ico">☁️</span>Upload file</button>
    <button class="dock-btn" id="dockSettings"><span class="ico">⚙️</span>Site settings</button>
    <button class="dock-btn" id="dockNotices"><span class="ico">📢</span>Notices</button>
    <button class="dock-btn" id="dockComments"><span class="ico">💬</span>Comments</button>
    <button class="dock-btn" id="dockChats"><span class="ico">✉️</span>Chats</button>
  </div>

  <footer class="site-footer" id="siteFooter"></footer>
</div>

<!-- ============ MODALS ============ -->
<!-- Upload -->
<div id="uploadModal" class="modal-overlay">
  <div class="modal">
    <div class="modal-head">
      <h3>Upload learning material</h3>
      <button class="close" data-close="uploadModal">×</button>
    </div>
    <div class="modal-body">
      <label class="muted">Title (optional)</label>
      <input id="upTitle" placeholder="Leave blank to use filename">
      <div class="grid-2" style="display:grid;grid-template-columns:1fr 1fr;gap:10px">
        <div>
          <label class="muted">Folder</label>
          <input id="upFolder" list="folderList" placeholder="e.g. Math / Class 8">
          <datalist id="folderList"></datalist>
        </div>
        <div>
          <label class="muted">Category</label>
          <select id="upCategory">
            <option value="">Auto-detect</option>
            <option>PDF</option>
            <option>Document</option>
            <option>Image</option>
            <option>Video</option>
            <option>Excel</option>
            <option>HTML</option>
            <option>Simulation</option>
            <option>Other</option>
          </select>
        </div>
      </div>
      <label class="muted">Description / instructions</label>
      <textarea id="upDesc" placeholder="What is this file about?"></textarea>
      <label class="muted" style="display:flex;align-items:center;gap:6px">
        <input type="checkbox" id="upSim" style="width:auto;margin:0"> Mark as simulation / interactive activity
      </label>

      <p class="muted" style="margin-top:14px">Choose a file type to upload from your device:</p>
      <div class="upload-grid">
        <button data-kind="pdf"><span class="ico">📄</span>PDF / Doc</button>
        <button data-kind="image"><span class="ico">🖼️</span>Image</button>
        <button data-kind="video"><span class="ico">🎬</span>Video</button>
        <button data-kind="excel"><span class="ico">📊</span>Excel / CSV</button>
        <button data-kind="html"><span class="ico">🌐</span>HTML / Zip</button>
        <button data-kind="any"><span class="ico">📁</span>Any file</button>
      </div>
      <div id="upProgress" class="progress hidden"><i></i></div>
      <p id="upMsg" class="up-msg"></p>

      <p class="muted" style="margin-top:18px;padding-top:14px;border-top:1px solid var(--line)">
        Or add a link manually (Drive, YouTube, simulation, etc.)
      </p>
